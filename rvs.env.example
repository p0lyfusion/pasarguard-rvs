# Copy to .env (gitignored) next to compose.yaml. `rvs --help` / `rvs shell --help` list every
# option with its variable. Command-line flags win.

# --- panel: the only credential. The admin needs users:read + nodes:read; nodes:read exposes
# every node's api_key, so this login is effectively full control of all nodes.
RVS_PANEL=https://panel.example
RVS_PANEL_ADMIN=rvs-readonly
RVS_PANEL_PASSWORD=change-me

# --- data plane: client half of RVS_ENTRY's VLESS encryption (`xray vlessenc`, the "encryption" line)
RVS_ENTRY_ENCRYPTION=mlkem768x25519plus.native.0rtt.REPLACE_ME
# RVS_ENTRY_PORT=10900
# RVS_ENTRY_TAG=RVS_ENTRY
# RVS_ENTRY_HOST=               # default: the node's address

# --- node selection (default: every connected gRPC node the panel lists)
# RVS_NODE=de1                  # one panel node by name
# RVS_NODE_CONFIG=/node.json    # a fixed node instead of the panel's list (mount it in compose.yaml)

# --- shell session
# RVS_QUERY=                    # pre-fill the fuzzy search
# RVS_DEVICE=42.7               # skip the picker (shell and standalone)
# RVS_ALLOW_OFFLINE=1           # with RVS_DEVICE: go ahead even if it isn't connected
# RVS_MTU=1380
# RVS_DNS=1.1.1.1
# RVS_SHELL=/bin/bash
# RVS_DRY_RUN=1                 # print the commands and xray config, change nothing

# --- standalone
# RVS_SOCKS_PORT=10808          # --json: SOCKS5 port (HTTP = +1)

# --- devices
# RVS_USER=42                   # only this user's devices
